{
  /*
   * TypeScript config for shared internal packages (packages/*).
   * The orchestrator package is held to full strictness because it
   * contains the security, routing, and resilience-critical code.
   */
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "moduleDetection": "force",
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["packages/shared", "packages/orchestrator", "packages/ai", "apps/api"],
  "exclude": ["**/node_modules/**", "**/dist/**"]
}
