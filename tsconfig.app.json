{
  /*
   * TypeScript config for the React SPA (src/).
   * Targets Vite/bundler resolution; noEmit because Vite handles emitting.
   * Leniency flags match the current codebase baseline; tighten over time
   * rather than gating the entire build on a full-strict migration.
   */
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "noEmit": true,
    "skipLibCheck": true,

    // Path aliases — kept in sync with vite.config.ts.
    "paths": {
      "@/*": ["./src/*"]
    },

    // Strictness — intentionally aligned with the legacy baseline.
    "strict": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false
  },
  "include": ["src"]
}
