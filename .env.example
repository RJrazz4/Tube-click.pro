# =============================================================================
# TubeClick Pro — Environment Variable Template
# =============================================================================
#
# Copy this file to `.env` for local development:
#     cp .env.example .env
#
# CRITICAL SECURITY RULE
# ----------------------
# Any variable whose name begins with VITE_ is INLINED into the client
# JavaScript bundle at build time. ONLY put non-secret public configuration
# (Supabase URL, anon key, app URL, public feature flags) behind a VITE_
# prefix. All API keys, service-role JWTs, signing secrets, and payment
# credentials must be server-only (no VITE_ prefix) and are consumed by
# Vercel/Supabase functions via `process.env` / `Deno.env`.
#
# See docs/ENVIRONMENT.md for the full variable reference, rotation
# procedures, and platform-specific setup (Vercel, Supabase, local dev).
# =============================================================================


# -----------------------------------------------------------------------------
# 1. APPLICATION IDENTITY  (public — VITE_ prefix is intentional)
# -----------------------------------------------------------------------------
VITE_APP_NAME=TubeClick Pro
VITE_APP_URL=https://tubeclickpro.in
# development | staging | production
VITE_APP_ENV=development


# -----------------------------------------------------------------------------
# 2. SUPABASE  (public + server)
# -----------------------------------------------------------------------------
# Public client — Supabase anon key is safe to ship; RLS enforces access.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
VITE_SUPABASE_PROJECT_ID=your_project_ref

# Server-only — service-role JWT, used for RPCs and admin operations.
# NEVER expose this to the client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here


# -----------------------------------------------------------------------------
# 2b. PAYMENT VERIFIER  (public — VITE_ prefix is intentional)
# -----------------------------------------------------------------------------
# Base URL of the TubeClick Pro payment verifier service (Render). This is a
# public URL — it is NOT a secret. The verifier authenticates requests using
# the caller's Supabase JWT (Authorization: Bearer <access_token>).
# Set this to your deployed verifier origin, e.g.:
#   VITE_PAYMENT_API_URL=https://tubeclick-payment-verifier.onrender.com
VITE_PAYMENT_API_URL=


# -----------------------------------------------------------------------------
# 3. AI ROUTING (server-only)
# -----------------------------------------------------------------------------
# Vercel AI Gateway bearer token (PREFERRED). When set, ALL LLM chat/JSON
# traffic routes through the Vercel AI Gateway — which handles retries,
# model fallback, rate-limit backoff, caching, and observability.
# Generate from: Vercel Dashboard → Project → AI Gateway → API Keys.
# No VITE_ prefix. Server-only.
AI_GATEWAY_API_KEY=ag_your_gateway_key_here

# Optional Gateway overrides (uncomment to change defaults):
# AI_GATEWAY_BASE_URL=https://gateway.vercel.sh/v1
# AI_GATEWAY_PRIMARY=google/gemini-2.5-flash
# AI_GATEWAY_FALLBACKS=meta-llama/llama-3.3-70b-instruct,openai/gpt-4o-mini
# AI_GATEWAY_TIMEOUT_MS=20000

# OpenRouter keys (LEGACY fallback). Used only when AI_GATEWAY_API_KEY is
# not configured. Comma-separated; rotated round-robin by the orchestrator.
OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2,sk-or-v1-key3

# Accepted legacy aliases (no need to set if OPENROUTER_API_KEYS is set):
#   OPENROUTER_API_KEY=sk-or-v1-single
#   OPENROUTER_API_KEY_1=...
#   OPENROUTER_API_KEY_2=...

# Optional model overrides. Defaults target a cost/quality sweet spot
# (Gemini-class model with flash fallbacks).
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_MODEL_FALLBACKS=google/gemini-2.5-flash-lite,meta-llama/llama-3.1-8b-instruct

# Optional attribution headers sent to OpenRouter for analytics.
# OPENROUTER_SITE_URL=https://tubeclickpro.in
# OPENROUTER_SITE_TITLE=TubeClick Pro

# Timeouts (milliseconds). The chat path is pinned to Vercel Edge and the
# orchestrator — budget keeps total wall-clock under the Vercel cap.
# OPENROUTER_CHAT_DEADLINE_MS=17000        # global budget across models+keys
# OPENROUTER_CHAT_ATTEMPT_TIMEOUT_MS=7000  # per-attempt upstream abort
# OPENROUTER_ATTEMPT_TIMEOUT_MS=15000      # per-attempt abort for seo/storyboard/clone-crush
# AI_RETRY_BUDGET_MS=12000                 # retry wall-clock budget


# -----------------------------------------------------------------------------
# 4. SECONDARY AI / MEDIA PROVIDERS  (server-only, optional)
# -----------------------------------------------------------------------------
# Gemini Flash adapter (used as a redundancy path and for certain routes).
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_AI_API_KEY=your_gemini_api_key_here

# Image generation — Fal.ai for Pro/Cinematic thumbnails and storyboard frames.
FAL_API_KEY=your_fal_key_here

# Voiceover — ElevenLabs TTS.
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Optional adapters (uncomment if you enable the route):
# REPLICATE_API_TOKEN=your_replicate_token
# TOGETHER_API_KEY=your_together_key
# HUGGINGFACE_API_KEY=your_hf_key
# AGNES_API_KEY=your_agnes_key
# POLLINATIONS_BASE_URL=https://image.pollinations.ai


# -----------------------------------------------------------------------------
# 5. YOUTUBE DATA  (server-only — required for Clone & Crush)
# -----------------------------------------------------------------------------
YOUTUBE_API_KEY=your_youtube_data_api_v3_key


# -----------------------------------------------------------------------------
# 6. AUTH / SIGNING SECRETS  (server-only, generate with `openssl rand -hex 32`)
# -----------------------------------------------------------------------------
# HMAC secret for referral share tokens and attribution cookies.
REFERRAL_SIGNING_SECRET=openssl_rand_-hex_32_value_here

# HMAC secret for the guest-preview soft-gate cookie.
GUEST_ACCESS_SECRET=openssl_rand_-hex_32_value_here


# -----------------------------------------------------------------------------
# 7. MONETIZATION
# -----------------------------------------------------------------------------
# Server-side URL for payment/license verification. The client never sees
# the raw locker response; entitlements are re-verified on every request.
LOCKER_URL=https://your-locker.example.com/verify

# Public sponsor placements are OFF by default. To enable, fill in every
# field below AND set VITE_SPONSOR_PLACEMENTS. The component fails-closed
# if the destination host is not in VITE_SPONSOR_ALLOWED_HOSTS.
# VITE_SPONSOR_PLACEMENTS=seo,voice
# VITE_SPONSOR_ALLOWED_HOSTS=partner.example.com
# VITE_SPONSOR_NAME=Partner Name
# VITE_SPONSOR_TAGLINE=Premium creator offer
# VITE_SPONSOR_OFFER=Exclusive benefit for TubeClick creators
# VITE_SPONSOR_CTA_TEXT=Claim Partner Perk
# VITE_SPONSOR_CTA_URL=https://partner.example.com/tubeclick
# VITE_SPONSOR_BADGE=Featured Partner


# -----------------------------------------------------------------------------
# 8. API ROUTING (public)
# -----------------------------------------------------------------------------
# When true, AI calls route to Vercel Edge (/api/*) — recommended in production.
# When false, the client falls back to Supabase Edge Functions (legacy path).
VITE_USE_VERCEL_EDGE=true
# Informational label surfaced in debug UI: "vercel" | "supabase"
VITE_API_MODE=vercel


# -----------------------------------------------------------------------------
# 9. ORCHESTRATOR OVERRIDES  (server-only, optional)
# -----------------------------------------------------------------------------
# Pooled image-provider keys, semicolon separated. Order = rotation order.
# Providers: agnes | gemini | hf (aliases: agnes-flash, gemini-flash, huggingface).
# IMAGE_API_KEYS=agnes:ak_1,ak_2;gemini:gk_1;hf:hf_1

# Enable Pollinations as a zero-cost fallback (no key required).
# POLLINATIONS_ENABLED=true

# Tier limits override, merged onto defaults. null = unlimited.
# TIER_LIMITS={"free":{"maxScenes":4,"thumbnailOptions":[1,2]},"pro":{"maxScenes":8,"thumbnailOptions":[1,2,4]},"cinematic":{"maxScenes":null,"thumbnailOptions":[1,2,4]}}

# CORS allow-list for production (comma-separated). If unset, permissive in dev.
# ALLOWED_ORIGINS=https://tubeclickpro.in
# RATE_LIMIT_FREE_RPM=12
# RATE_LIMIT_PRO_RPM=60
# LOG_LEVEL=info
