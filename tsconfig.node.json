{
  /*
   * TypeScript config for Node-side tooling (Vite config, scripts).
   * Strict mode is enabled because this surface is small and
   * build/tooling bugs are disproportionately expensive.
   */
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "tailwind.config.ts",
    "eslint.config.js",
    "postcss.config.js",
    "scripts/**/*.ts",
    "scripts/**/*.mjs"
  ]
}
